<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlavorMasterSYS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlavorMasterSYS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Flavor Master - POS Restaurant System">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource SystemAccentColorDark1}" Padding="16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🍽️ Flavor Master" 
                               Style="{ThemeResource TitleTextBlockStyle}" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
                    <TextBlock x:Name="UserInfoTextBlock" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                    <Button x:Name="LogoutButton" 
                            Content="🚪 Salir / Logout" 
                            Click="LogoutButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Navigation -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Menu -->
            <Border x:Name="NavigationPanel" 
                    Grid.Column="0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Width="200"
                    Visibility="Collapsed">
                <StackPanel Padding="8" Spacing="4">
                    <Button x:Name="NavPOS" 
                            Content="🛒 POS" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="NavPOS_Click"/>
                    <Button x:Name="NavDashboard" 
                            Content="📊 Dashboard" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="NavDashboard_Click"/>
                    <Button x:Name="NavInventory" 
                            Content="📦 Inventario" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="NavInventory_Click"/>
                    <Button x:Name="NavUsers" 
                            Content="👥 Usuarios" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="NavUsers_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Page Content -->
            <Frame x:Name="ContentFrame" Grid.Column="1"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource SystemAccentColorDark2}" Padding="8,4">
            <Grid>
                <TextBlock x:Name="StatusTextBlock" Text="Sistema listo / System ready" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeTextBlock" HorizontalAlignment="Right" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
