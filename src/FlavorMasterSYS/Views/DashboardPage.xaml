<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlavorMasterSYS.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlavorMasterSYS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Dashboard" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Resumen de ventas y operaciones" 
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Stats Cards - Modern Design -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Today's Sales -->
                <Border Grid.Column="0" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="0,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8">
                        <Border Background="White" 
                                Opacity="0.2" 
                                CornerRadius="12" 
                                Width="48" 
                                Height="48"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE8C8;" 
                                      FontSize="24" 
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ventas Hoy" 
                                   Foreground="White" 
                                   Opacity="0.9"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="TodaySalesText" 
                                   Text="$0.00" 
                                   Foreground="White" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Today's Orders -->
                <Border Grid.Column="1" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#11998e" Offset="0"/>
                            <GradientStop Color="#38ef7d" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8">
                        <Border Background="White" 
                                Opacity="0.2" 
                                CornerRadius="12" 
                                Width="48" 
                                Height="48"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE9D5;" 
                                      FontSize="24" 
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Órdenes Hoy" 
                                   Foreground="White" 
                                   Opacity="0.9"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="TodayOrdersText" 
                                   Text="0" 
                                   Foreground="White" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Active Orders -->
                <Border Grid.Column="2" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#f093fb" Offset="0"/>
                            <GradientStop Color="#f5576c" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8">
                        <Border Background="White" 
                                Opacity="0.2" 
                                CornerRadius="12" 
                                Width="48" 
                                Height="48"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE823;" 
                                      FontSize="24" 
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Órdenes Activas" 
                                   Foreground="White" 
                                   Opacity="0.9"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="ActiveOrdersText" 
                                   Text="0" 
                                   Foreground="White" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock Alert -->
                <Border Grid.Column="3" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="8,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#eb3349" Offset="0"/>
                            <GradientStop Color="#f45c43" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8">
                        <Border Background="White" 
                                Opacity="0.2" 
                                CornerRadius="12" 
                                Width="48" 
                                Height="48"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE7BA;" 
                                      FontSize="24" 
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Stock Bajo" 
                                   Foreground="White" 
                                   Opacity="0.9"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="LowStockText" 
                                   Text="0" 
                                   Foreground="White" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Content Grid -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top Products -->
                <Border Grid.Column="0" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="0,0,8,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Width="40" Height="40">
                                <FontIcon Glyph="&#xE8D1;" 
                                          FontSize="18" 
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Productos Más Vendidos" 
                                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="Top 5 del período" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <ListView x:Name="TopProductsListView" 
                                  Grid.Row="1" 
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProductName}" 
                                                       Grid.Column="0"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                            <Border Grid.Column="1" 
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Margin="8,0">
                                                <TextBlock Text="{Binding QuantitySold}" 
                                                           Foreground="White"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="$"/>
                                                <Run Text="{Binding TotalRevenue}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Recent Orders -->
                <Border Grid.Column="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="8,0,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Width="40" Height="40">
                                <FontIcon Glyph="&#xE823;" 
                                          FontSize="18" 
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Órdenes Recientes" 
                                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="Últimas 10 órdenes" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <ListView x:Name="RecentOrdersListView" 
                                  Grid.Row="1" 
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding OrderNumber}" 
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Mesa:"/>
                                                    <Run Text="{Binding TableNumber}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                       VerticalAlignment="Center"
                                                       Margin="8,0"
                                                       FontWeight="SemiBold">
                                                <Run Text="$"/>
                                                <Run Text="{Binding Total}"/>
                                            </TextBlock>
                                            <Border Grid.Column="2"
                                                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" 
                                                           Foreground="White"
                                                           FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
