<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlavorMasterSYS.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlavorMasterSYS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="📊 Dashboard / Panel de Control" 
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="0,0,0,24"/>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Today's Sales -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource SystemAccentColorDark1}" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="💰 Ventas Hoy" Foreground="White" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock x:Name="TodaySalesText" Text="$0.00" Foreground="White" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Today's Orders -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource SystemAccentColor}" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="📋 Órdenes Hoy" Foreground="White" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock x:Name="TodayOrdersText" Text="0" Foreground="White" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Active Orders -->
            <Border Grid.Column="2" 
                    Background="{ThemeResource SystemFillColorCautionBrush}" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="🔄 Órdenes Activas" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock x:Name="ActiveOrdersText" Text="0" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Low Stock -->
            <Border Grid.Column="3" 
                    Background="{ThemeResource SystemFillColorCriticalBrush}" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="⚠️ Stock Bajo" Foreground="White" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock x:Name="LowStockText" Text="0" Foreground="White" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Products -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🏆 Productos Más Vendidos / Top Products" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               Margin="0,0,0,16"/>
                    <ListView x:Name="TopProductsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProductName}" Grid.Column="0"/>
                                    <TextBlock Text="{Binding QuantitySold}" Grid.Column="1" Margin="16,0"/>
                                    <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" Grid.Column="2"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Recent Orders -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="📝 Órdenes Recientes / Recent Orders" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               Margin="0,0,0,16"/>
                    <ListView x:Name="RecentOrdersListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding OrderNumber}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{Binding TableNumber}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" Grid.Column="2" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
