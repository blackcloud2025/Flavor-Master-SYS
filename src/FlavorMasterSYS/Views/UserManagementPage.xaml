<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlavorMasterSYS.Views.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlavorMasterSYS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="👥 Gestión de Usuarios / User Management" 
                       Style="{ThemeResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>
            <Button x:Name="AddUserButton" 
                    Content="➕ Nuevo Usuario / New User" 
                    HorizontalAlignment="Right"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="AddUserButton_Click"/>
        </Grid>

        <!-- Users List -->
        <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="8" 
                Padding="16">
            <ListView x:Name="UsersListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding FullName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{Binding Username}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                <Run Text="Activo: "/>
                                <Run Text="{Binding IsActive}"/>
                            </TextBlock>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                <Run Text="Dashboard: "/>
                                <Run Text="{Binding CanViewDashboard}"/>
                            </TextBlock>

                            <TextBlock Grid.Column="4" Text="{Binding LastLogin}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                                <Button Content="✏️" Click="EditUserButton_Click" Tag="{Binding}" ToolTipService.ToolTip="Editar / Edit"/>
                                <Button Content="🗑️" Click="DeleteUserButton_Click" Tag="{Binding}" ToolTipService.ToolTip="Eliminar / Delete"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
