<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlavorMasterSYS.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlavorMasterSYS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    Width="350" 
                    Spacing="16">
            
            <!-- Logo/Title -->
            <TextBlock Text="🍽️" 
                       FontSize="64" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Flavor Master" 
                       Style="{ThemeResource TitleLargeTextBlockStyle}" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="POS Restaurant System" 
                       Style="{ThemeResource SubtitleTextBlockStyle}" 
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Login Form -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="24"
                    Margin="0,24,0,0">
                <StackPanel Spacing="16">
                    <TextBox x:Name="UsernameTextBox" 
                             Header="Usuario / Username" 
                             PlaceholderText="Enter your username"/>
                    
                    <PasswordBox x:Name="PasswordBox" 
                                 Header="Contraseña / Password" 
                                 PlaceholderText="Enter your password"/>

                    <TextBlock x:Name="ErrorTextBlock" 
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <Button x:Name="LoginButton" 
                            Content="Iniciar Sesión / Login" 
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Default credentials hint -->
            <TextBlock Text="Default: master / master123" 
                       Style="{ThemeResource CaptionTextBlockStyle}" 
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
